# Copie para .env (ou configure no serviço de hospedagem). Nunca envie o .env ao GitHub.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_ALLOWED_HOSTS=seu-dominio.exemplo
DJANGO_FORCE_HTTPS=1
# PostgreSQL gerenciado (se DB_NAME não for definido, usa SQLite só para desenvolvimento)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=require
